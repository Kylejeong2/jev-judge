# "anthropic" (default) or "openai" (any OpenAI-compatible chat/completions endpoint)
JEV_PROVIDER=anthropic
# Model id. Defaults: claude-sonnet-4-5 (anthropic) / gpt-4o (openai)
JEV_MODEL=
# Falls back to ANTHROPIC_API_KEY / OPENAI_API_KEY if unset
JEV_API_KEY=
# Override for self-hosted / proxy endpoints (e.g. a fine-tuned "Jev" behind an OpenAI-compatible server)
JEV_BASE_URL=
